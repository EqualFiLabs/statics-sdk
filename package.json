{
  "name": "@statics-protocol/sdk",
  "version": "0.1.0",
  "description": "Quotes, calldata builders, and protocol pool interfaces for Statics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./genesis-credit": {
      "types": "./dist/genesis-credit.d.ts",
      "import": "./dist/genesis-credit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:config": "node scripts/generate-robinhood-config.mjs",
    "prebuild": "npm run generate:config",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run generate:config",
    "test": "vitest run"
  },
  "peerDependencies": {
    "viem": ">=2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "viem": "^2.0.0",
    "vitest": "^3.0.0"
  },
  "license": "BUSL-1.1"
}
